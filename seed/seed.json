{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "RedeemID starter",
		"description": "An EmDash site with Shopify commerce: a shop, a cart, Shopify checkout, store sign-in and members-only posts",
		"author": "RedeemID"
	},
	"settings": {
		"title": "My Site",
		"tagline": "Content on EmDash, commerce on Shopify"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": [
				"posts"
			],
			"terms": [
				{
					"slug": "general",
					"label": "General"
				},
				{
					"slug": "updates",
					"label": "Updates"
				},
				{
					"slug": "members",
					"label": "Members"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": [
				"posts"
			],
			"terms": [
				{
					"slug": "starter",
					"label": "Starter"
				},
				{
					"slug": "example",
					"label": "Example"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "Posts",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "Shop",
					"url": "/shop/"
				},
				{
					"type": "custom",
					"label": "Join",
					"url": "/join/"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5
					}
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This is the about page. Edit it in the admin panel or replace this template with your own design.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-1",
				"slug": "welcome",
				"status": "published",
				"data": {
					"title": "Welcome",
					"excerpt": "Your first post. Replace this with your own content.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This site runs its content on EmDash and its commerce on Shopify. The shop, the cart and checkout come from your Shopify store, and readers sign in with the account they use at your store.",
									"_key": "k0s"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "What to do next",
									"_key": "k2s"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Open the admin and go to Plugins → RedeemID → Setup. It walks through connecting your store, step by step, and says which steps are done.",
									"_key": "k4s"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Then tag a test customer \"member\" in Shopify, sign in as them, and open the Members post. It opens for them and stays locked for everyone else.",
									"_key": "k6s"
								}
							],
							"_key": "k6"
						}
					]
				},
				"taxonomies": {
					"category": [
						"general"
					],
					"tag": [
						"starter",
						"example"
					]
				}
			},
			{
				"id": "post-members",
				"slug": "members-only",
				"status": "published",
				"data": {
					"title": "A post for members",
					"excerpt": "Everyone reads the opening. Members read the rest.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Everyone can read this opening. The Paywall break below marks where the members-only part starts.",
									"_key": "m0s"
								}
							],
							"_key": "m0"
						},
						{
							"_type": "redeemid-paywall",
							"_key": "m1"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Only members read this part. Readers who are not members see the opening, then a panel that asks them to sign in or join. This part never reaches their browser.",
									"_key": "m2s"
								}
							],
							"_key": "m2"
						}
					]
				},
				"taxonomies": {
					"category": [
						"members"
					]
				}
			}
		]
	}
}
