---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import AccessBadge from "@redeemid/emdash/components/AccessBadge.astro";
import Content from "@redeemid/emdash/components/Content.astro";
import { cacheEntry } from "@redeemid/emdash/cache";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

// Cached only when it reads the same for everyone; gated posts stay out.
await cacheEntry(Astro, "posts", post, cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article>
		{
			post.data.featured_image && (
				<div {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<h1 {...post.edit.title}>{post.data.title}</h1>

		<AccessBadge collection="posts" terms={post.data.terms} content={post.data.content} id={post.id} />

		{
			post.data.publishedAt && (
				<time datetime={post.data.publishedAt.toISOString()}>
					{post.data.publishedAt.toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			)
		}

		{
			categories.length > 0 && (
				<div>
					{categories.map((c) => (
						<a href={`/category/${c.slug}`}>{c.label}</a>
					))}
				</div>
			)
		}

		<Content value={post.data.content} collection="posts" terms={post.data.terms} id={post.id} title={post.data.title} />

		{
			tags.length > 0 && (
				<div>
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`}>{t.label}</a>
					))}
				</div>
			)
		}
	</article>

	<aside>
		<WidgetArea name="sidebar" />
	</aside>
</Base>
